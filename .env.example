# Public site URL (used for SEO, sitemap, canonical links, email logo)
NEXT_PUBLIC_SITE_URL=https://sori-mobile-tire.com
# Set to true on the staging site so search engines don't index it (build-time)
NEXT_PUBLIC_NOINDEX=false

# MySQL (Hostinger: the Node app must use 127.0.0.1, not localhost)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Alternatively: DATABASE_URL=mysql://user:password@127.0.0.1:3306/dbname

# SMTP — public contact is sorimobiletire@gmail.com
# Option A (current Hostinger mailbox for send auth): keep smtp.hostinger.com + contact@…
# Option B (send as Gmail): smtp.gmail.com:465 + Gmail App Password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@sori-mobile-tire.com
SMTP_PASSWORD=
# With Hostinger SMTP, From must match SMTP_USER; Reply-To uses site.email (Gmail)
MAIL_FROM="SORI Mobile Tire <contact@sori-mobile-tire.com>"
NOTIFY_EMAIL=sorimobiletire@gmail.com
# Customer confirmation emails are ON by default; set to false only to disable
SEND_CUSTOMER_CONFIRMATION=true

# Mini-admin at /admin (required to enable the staff desk)
ADMIN_EMAIL=sorimobiletire@gmail.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional SMS via Twilio (customer SMS after forms)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional Sentry error reporting (forms / server errors)
SENTRY_DSN=

# Optional social profile links (hidden when empty)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
